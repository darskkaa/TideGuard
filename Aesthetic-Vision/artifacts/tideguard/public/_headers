/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://services.arcgisonline.com https://tilecache.rainviewer.com; font-src 'self' data:; connect-src 'self' https://api.open-meteo.com https://gis.myfwc.com https://api.weather.gov https://api.rainviewer.com https://services.arcgisonline.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
